\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Slang-sense occurrences per million tokens by FineWeb crawl dump (linear scale, RoBERTa score $\geq 0.99$, 5-dump smoothing, 95\% Poisson CI) for the pre-2018 declining band (\textit  {lol, sick, troll, bro, swag} plus the additional terms \textit  {omg, meh, lmao}). The y-axis is broken so \textit  {lol} (peak $\sim $16/M) sits in its own upper panel and does not flatten the rest: \textit  {lol}, \textit  {omg}, and \textit  {sick} decline steadily after $\sim $2018 and \textit  {swag} drifts downward, while \textit  {troll}, \textit  {bro}, \textit  {meh}, and \textit  {lmao} sit lower and taper more gently.}}{7}{figure.caption.11}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:cc-pre2018}{{1}{7}{Slang-sense occurrences per million tokens by FineWeb crawl dump (linear scale, RoBERTa score $\geq 0.99$, 5-dump smoothing, 95\% Poisson CI) for the pre-2018 declining band (\textit {lol, sick, troll, bro, swag} plus the additional terms \textit {omg, meh, lmao}). The y-axis is broken so \textit {lol} (peak $\sim $16/M) sits in its own upper panel and does not flatten the rest: \textit {lol}, \textit {omg}, and \textit {sick} decline steadily after $\sim $2018 and \textit {swag} drifts downward, while \textit {troll}, \textit {bro}, \textit {meh}, and \textit {lmao} sit lower and taper more gently}{figure.caption.11}{}}
