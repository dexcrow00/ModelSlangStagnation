\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Corpus frequency for the around-2020 rising band (linear scale, RoBERTa score $\geq 0.99$, 5-dump smoothing, 95\% Poisson CI): \textit  {vibe, vibes, alpha, red pill} plus the additional term \textit  {legit}. \textit  {vibe}, \textit  {vibes}, and \textit  {legit} rise through the late 2010s and into the 2020s; \textit  {alpha} stays low and roughly flat, and \textit  {red pill}, a rarer and noisier term, sits near the floor with correspondingly wide confidence bands.}}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:cc-around2020}{{2}{7}{Corpus frequency for the around-2020 rising band (linear scale, RoBERTa score $\geq 0.99$, 5-dump smoothing, 95\% Poisson CI): \textit {vibe, vibes, alpha, red pill} plus the additional term \textit {legit}. \textit {vibe}, \textit {vibes}, and \textit {legit} rise through the late 2010s and into the 2020s; \textit {alpha} stays low and roughly flat, and \textit {red pill}, a rarer and noisier term, sits near the floor with correspondingly wide confidence bands}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Corpus frequency for the 2022--2024 recent-riser band (linear scale, RoBERTa score $\geq 0.99$, 5-dump smoothing, 95\% Poisson CI): \textit  {slay, gaslight, glow-up, aura} plus the additional terms \textit  {lowkey, situationship}. \textit  {slay} and \textit  {lowkey} climb over the window, and \textit  {gaslight}, \textit  {glow-up}, and \textit  {situationship} appear only near its end --- slang that postdates the bulk of the models' training data, though still within the models' training windows. \textit  {aura} (in its Gen-Z slang sense) is noisier and rises less cleanly.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:cc-2022-24}{{3}{7}{Corpus frequency for the 2022--2024 recent-riser band (linear scale, RoBERTa score $\geq 0.99$, 5-dump smoothing, 95\% Poisson CI): \textit {slay, gaslight, glow-up, aura} plus the additional terms \textit {lowkey, situationship}. \textit {slay} and \textit {lowkey} climb over the window, and \textit {gaslight}, \textit {glow-up}, and \textit {situationship} appear only near its end --- slang that postdates the bulk of the models' training data, though still within the models' training windows. \textit {aura} (in its Gen-Z slang sense) is noisier and rises less cleanly}{figure.caption.13}{}}
