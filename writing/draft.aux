\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Probed target words, temporal band, corpus peak year, peak-year slang-sense rate (occurrences per million tokens), and total slang-sense hits across the FineWeb 10BT sample (RoBERTa sense score $\geq 0.99$). Peak year is the argmax, over calendar years, of the token-normalised yearly rate; ``Hits'' is the raw count of above-threshold occurrences pooled over all 95 dumps. Rates span nearly three orders of magnitude, from the saturated \textit  {lol} (16.2 per M) to the emergent \textit  {glow-up} (0.04 per M).}}{15}{table.caption.26}\protected@file@percent }
\newlabel{tab:words}{{1}{15}{Probed target words, temporal band, corpus peak year, peak-year slang-sense rate (occurrences per million tokens), and total slang-sense hits across the FineWeb 10BT sample (RoBERTa sense score $\geq 0.99$). Peak year is the argmax, over calendar years, of the token-normalised yearly rate; ``Hits'' is the raw count of above-threshold occurrences pooled over all 95 dumps. Rates span nearly three orders of magnitude, from the saturated \textit {lol} (16.2 per M) to the emergent \textit {glow-up} (0.04 per M)}{table.caption.26}{}}
